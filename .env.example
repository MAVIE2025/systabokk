# Base PostgreSQL (PostgreSQL géré Systalink en production)
DATABASE_URL=postgres://systabokk:systabokk@localhost:5432/systabokk

# Adresse interne de l'application, pour joindre les API de démo hébergées dans l'appli
INTERNAL_BASE_URL=http://localhost:3000

# Part reversée au créateur sur chaque appel (en %), le reste est la commission plateforme
CREATOR_SHARE_PERCENT=90

# Jeton pour simuler la panne du fournisseur A pendant la démo
DEMO_ADMIN_TOKEN=change-moi

# Domaine public (utilisé par Caddy pour le HTTPS)
DOMAIN=systabokk.example.com
