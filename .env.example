# Domaine public (Caddy obtient le certificat HTTPS automatiquement)
DOMAIN=systabokk.example.com

# Base PostgreSQL du serveur : choisissez un mot de passe long
POSTGRES_PASSWORD=change-moi-mot-de-passe-long
DATABASE_URL=postgres://systabokk:change-moi-mot-de-passe-long@db:5432/systabokk
# En local (hors Docker) : postgres://systabokk:systabokk@localhost:5432/systabokk

# Adresse interne de l'application (API de démo et bouton « Essayer »)
INTERNAL_BASE_URL=http://127.0.0.1:3000

# Part reversée au créateur sur chaque appel (en %)
CREATOR_SHARE_PERCENT=90

# Clé du compte Pass Jury (générez-en une : sbk_live_ suivi de 32 caractères)
PASS_JURY_KEY=sbk_live_remplacez-moi-par-une-cle-longue-et-secrete

# Jeton des pannes simulées en ligne de commande (démo)
DEMO_ADMIN_TOKEN=change-moi
