{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/catalogue/[slug]",
      "regex": "^/catalogue/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/catalogue/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/demo-apis/paiement/[fournisseur]/[[...path]]",
      "regex": "^/demo\\-apis/paiement/([^/]+?)(?:/(.+?))?(?:/)?$",
      "routeKeys": {
        "nxtPfournisseur": "nxtPfournisseur",
        "nxtPpath": "nxtPpath"
      },
      "namedRegex": "^/demo\\-apis/paiement/(?<nxtPfournisseur>[^/]+?)(?:/(?<nxtPpath>.+?))?(?:/)?$"
    },
    {
      "page": "/demo-apis/sms/[fournisseur]/[[...path]]",
      "regex": "^/demo\\-apis/sms/([^/]+?)(?:/(.+?))?(?:/)?$",
